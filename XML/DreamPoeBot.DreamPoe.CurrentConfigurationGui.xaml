<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DreamPoeBot.DreamPoe.CurrentConfigurationGui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localization="clr-namespace:DreamPoeBot.Localization.Wpf;assembly=DreamPoeBot.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DreamPoeBot.DreamPoe">
  <Grid>
    <StackPanel>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Margin="3">
          <ContentControl.Content>
            <localization:LocalizedExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Tree.Configuration</Ctor>
            </localization:LocalizedExtension>
          </ContentControl.Content>
        </Label>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="3" IsReadOnly="True" Text="{Binding Path=Name, Mode=OneWay}" />
      </Grid>
    </StackPanel>
  </Grid>
</UserControl>