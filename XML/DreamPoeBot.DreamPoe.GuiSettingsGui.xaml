<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DreamPoeBot.DreamPoe.GuiSettingsGui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localization="clr-namespace:DreamPoeBot.Localization.Wpf;assembly=DreamPoeBot.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DreamPoeBot.DreamPoe" xmlns:lex="http://wpflocalizeextension.codeplex.com">
  <ScrollViewer>
    <Grid>
      <StackPanel>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Label Grid.Row="0" Grid.Column="0" Margin="3">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.NoHideOnMinimize</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <CheckBox Grid.Row="0" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=NoHideOnMinimize, Mode=TwoWay}" />
          <Label Grid.Row="1" Grid.Column="0" Margin="3">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Content.DisabledContent</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <DataGrid Grid.Row="1" Grid.Column="1" CanUserSortColumns="False" AutoGenerateColumns="False" AllowDrop="False" ItemsSource="{Binding DisabledContent}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" MinWidth="200" Binding="{Binding Name}">
                <DataGridColumn.Header>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Common.Name</Ctor>
                  </localization:LocalizedExtension>
                </DataGridColumn.Header>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Label Grid.Row="2" Grid.Column="0" Margin="3">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Content.Order</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <DataGrid Grid.Row="2" Grid.Column="1" CanUserSortColumns="False" AutoGenerateColumns="False" AllowDrop="False" ItemsSource="{Binding ContentOrder}">
            <DataGrid.Columns>
              <DataGridTextColumn Width="*" MinWidth="200" Binding="{Binding Name}">
                <DataGridColumn.Header>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Common.Name</Ctor>
                  </localization:LocalizedExtension>
                </DataGridColumn.Header>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <Label Grid.Row="3" Grid.Column="0" Margin="3">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Compilation.ExitOnCompileErrors</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <CheckBox Grid.Row="3" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=ExitOnCompileErrors, Mode=TwoWay}" />
          <Label Grid.Row="4" Grid.Column="0" Margin="3">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Compilation.ExitOnLoadErrors</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <CheckBox Grid.Row="4" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=ExitOnLoadErrors, Mode=TwoWay}" />
          <Label Grid.Row="5" Grid.Column="0" Margin="3">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Compilation.CompileAsynchronously</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <CheckBox Grid.Row="5" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=CompileAsynchronously, Mode=TwoWay}" />
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>