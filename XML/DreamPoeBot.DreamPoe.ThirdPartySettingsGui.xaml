<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DreamPoeBot.DreamPoe.ThirdPartySettingsGui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localization="clr-namespace:DreamPoeBot.Localization.Wpf;assembly=DreamPoeBot.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DreamPoeBot.DreamPoe">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <Grid>
        <DataGrid Name="InstanceDataGrid" CanUserSortColumns="False" AutoGenerateColumns="False" AllowDrop="False">
          <DataGrid.Columns>
            <DataGridTemplateColumn>
              <DataGridColumn.Header>
                <localization:LocalizedExtension>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Common.Name</Ctor>
                </localization:LocalizedExtension>
              </DataGridColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Label Content="{Binding Path=Name}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn>
              <DataGridColumn.Header>
                <localization:LocalizedExtension>
                  <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Common.CurrentAssembly</Ctor>
                </localization:LocalizedExtension>
              </DataGridColumn.Header>
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Label Content="{Binding Path=CompiledAssembly}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
          <!--Unknown connection ID: 1-->
        </DataGrid>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>