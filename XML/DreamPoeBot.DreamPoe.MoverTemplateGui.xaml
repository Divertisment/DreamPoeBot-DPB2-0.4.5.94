<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DreamPoeBot.DreamPoe.MoverTemplateGui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localization="clr-namespace:DreamPoeBot.Localization.Wpf;assembly=DreamPoeBot.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DreamPoeBot.DreamPoe">
  <Grid>
    <GroupBox Padding="5" HorizontalAlignment="Left, Stretch" VerticalAlignment="Top, Stretch">
      <HeaderedContentControl.Header>
        <WrapPanel>
          <CheckBox Name="MoverTemplateGuiMoverActiveCheckBox" IsEnabled="False" VerticalAlignment="Center">Active<!--Unknown connection ID: 1--></CheckBox>
          <Label VerticalAlignment="Center" Content="|" />
          <TextBlock Name="MoverTemplateGuiMoverGuideTextBlock">
            <Hyperlink Name="MoverTemplateGuiMoverGuideHyperlink" BaselineAlignment="Center">Guide<!--Unknown connection ID: 3--></Hyperlink> <Label VerticalAlignment="Center" Content="|" /><!--Unknown connection ID: 2--></TextBlock>
          <Label VerticalAlignment="Center">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Content.Metadata.Author</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <Label Name="MoverTemplateGuiMoverAuthorLabel" VerticalAlignment="Center" Content="">
            <!--Unknown connection ID: 4-->
          </Label>
          <Label VerticalAlignment="Center" Content="|" />
          <Label VerticalAlignment="Center">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Content.Metadata.Version</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <Label Name="MoverTemplateGuiMoverVersionLabel" VerticalAlignment="Center" Content="">
            <!--Unknown connection ID: 5-->
          </Label>
          <Label VerticalAlignment="Center" Content="|" />
          <Label VerticalAlignment="Center">
            <ContentControl.Content>
              <localization:LocalizedExtension>
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Content.Metadata.Description</Ctor>
              </localization:LocalizedExtension>
            </ContentControl.Content>
          </Label>
          <Label Name="MoverTemplateGuiMoverDescriptionLabel" VerticalAlignment="Center" Content="">
            <!--Unknown connection ID: 6-->
          </Label>
        </WrapPanel>
      </HeaderedContentControl.Header>
      <UserControl Name="MoverTemplateGuiContentUserControl" HorizontalAlignment="Left, Stretch" VerticalAlignment="Top, Stretch" IsEnabled="{Binding ElementName=MoverTemplateGuiMoverActiveCheckBox, Path=IsChecked}">
        <!--Unknown connection ID: 7-->
      </UserControl>
    </GroupBox>
  </Grid>
</UserControl>