<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DreamPoeBot.DreamPoe.GlobalSettingsGui" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localization="clr-namespace:DreamPoeBot.Localization.Wpf;assembly=DreamPoeBot.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:DreamPoeBot.DreamPoe" xmlns:lex="http://wpflocalizeextension.codeplex.com">
  <TabControl>
    <TabItem HorizontalAlignment="Left" VerticalContentAlignment="Top">
      <HeaderedContentControl.Header>
        <localization:LocalizedExtension>
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Tab.General</Ctor>
        </localization:LocalizedExtension>
      </HeaderedContentControl.Header>
      <ScrollViewer>
        <Grid VerticalAlignment="Top">
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Label Grid.Row="0" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Authentication.AutoLogin</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="0" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=AutoAuthLogin, Mode=TwoWay}" />
              <Label Grid.Row="2" Grid.Column="0" Margin="3,5,3,1">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.AuthenticationKey</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <TextBox Grid.Row="2" Grid.Column="1" Margin="3" IsReadOnly="True" Text="{Binding Path=AuthKey, Mode=TwoWay}" />
              <Label Grid.Row="3" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.DisableAutomaticUpdates</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="3" Grid.Column="1" Content="" Margin="2,3,-2,-3" IsChecked="{Binding Path=DisableUpdateCheck, Mode=TwoWay}" />
              <Label Grid.Row="5" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.AutoSelectLanguage</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="5" Grid.Column="1" Content="" Margin="2,3,-2,-3" IsChecked="{Binding AutoChooseLanguage}" />
              <Label Grid.Row="6" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Configuration.Selection.AutoSelect</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="6" Grid.Column="1" Content="" Margin="2,3,-2,-3" IsChecked="{Binding AutoChooseConfig}" />
              <Label Grid.Row="7" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.AllowExternalAccess</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="7" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=AllowExternalAccess, Mode=TwoWay}" />
              <Label Grid.Row="8" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.DebugLastTask</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="8" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=DebugLastTask, Mode=TwoWay}" />
              <Label Grid.Row="9" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.DebugTicks</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="9" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=DebugTicks, Mode=TwoWay}" />
              <Label Grid.Row="10" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.UpdaterName</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <TextBox Grid.Row="10" Grid.Column="1" Margin="3" Text="{Binding Path=DPB2UpdaterName, Mode=TwoWay}" />
              <Label Grid.Row="11" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.DoNotFocusGame</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="11" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=DontAutoFocusGameWindow, Mode=TwoWay}" />
              <Label Grid.Row="12" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.DoNotFocusBot</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="12" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=DontAutoFocusBotWindow, Mode=TwoWay}" />
              <Label Grid.Row="13" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.LogOutOnAuthenticationIssue</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="13" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=LogoutPoeOnAuthIssue2, Mode=TwoWay}" />
              <Label Grid.Row="14" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.UseStringPool</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="14" Grid.Column="1" Margin="3,5,3,1" IsChecked="{Binding Path=UseStringPool, Mode=TwoWay}">
                <FrameworkElement.ToolTip>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.UseStringPool.ToolTip</Ctor>
                  </localization:LocalizedExtension>
                </FrameworkElement.ToolTip>
              </CheckBox>
              <Button Grid.Row="15" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.DumpTerrain</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
                <FrameworkElement.ToolTip>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.General.DumpTerrain.ToolTip</Ctor>
                  </localization:LocalizedExtension>
                </FrameworkElement.ToolTip>
                <!--Unknown connection ID: 1-->
              </Button>
            </Grid>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </TabItem>
    <TabItem HorizontalAlignment="Left" VerticalContentAlignment="Top">
      <HeaderedContentControl.Header>
        <localization:LocalizedExtension>
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Bot.Render</Ctor>
        </localization:LocalizedExtension>
      </HeaderedContentControl.Header>
      <ScrollViewer>
        <Grid VerticalAlignment="Top">
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Label Grid.Row="0" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Render.StopOnHook</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="0" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=StopRenderOnHook, Mode=TwoWay}" />
              <Label Grid.Row="1" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Render.MinimizeGameOnHook</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="1" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=MinimizeGameOnHook, Mode=TwoWay}" />
              <Label Grid.Row="2" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Render.EnableBackgroundFps</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="2" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=IsBackgroundFpsActive, Mode=TwoWay}" />
              <Label Grid.Row="3" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Render.BackgroundFps</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <WrapPanel Grid.Row="3" Grid.Column="1" Margin="3,5,3,1">
                <Slider Name="BackgroundFpsStepSlider" Margin="3" Minimum="10" Maximum="100" TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True" Width="100" IsEnabled="{Binding Path=IsBackgroundFpsActive}" Value="{Binding Path=BackgroundFps}">
                  <!--Unknown connection ID: 2-->
                </Slider>
                <TextBox TextAlignment="Center" Width="25" Margin="3" IsEnabled="{Binding Path=IsBackgroundFpsActive}" Text="{Binding ElementName=BackgroundFpsStepSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
              </WrapPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </TabItem>
    <TabItem HorizontalAlignment="Left" VerticalContentAlignment="Top">
      <HeaderedContentControl.Header>
        <localization:LocalizedExtension>
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Tab.Mouse</Ctor>
        </localization:LocalizedExtension>
      </HeaderedContentControl.Header>
      <ScrollViewer>
        <Grid>
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Label Grid.Row="0" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Mouse.EnableDebuggerOnHook</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="0" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=EnableMouseDegudOnHook, Mode=TwoWay}" />
              <Label Grid.Row="1" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Mouse.HumanLike</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="1" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=HumanLikeMouse, Mode=TwoWay}" />
              <Label Grid.Row="2" Grid.Column="0" Margin="3" IsEnabled="{Binding Path=HumanLikeMouse}">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Mouse.Delay</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <WrapPanel Grid.Row="2" Grid.Column="1" Margin="3,5,3,1" IsEnabled="{Binding Path=HumanLikeMouse}">
                <Slider Name="HumanLikeMouseMaxStepSlider" Margin="3" Minimum="1" Maximum="15" TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True" Width="100" Value="{Binding Path=HumanLikeMouseMaxStep}">
                  <!--Unknown connection ID: 3-->
                </Slider>
                <TextBox TextAlignment="Center" Width="25" Margin="3" Text="{Binding ElementName=HumanLikeMouseMaxStepSlider, Path=Value, UpdateSourceTrigger=PropertyChanged}" />
              </WrapPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </TabItem>
    <TabItem HorizontalAlignment="Left" VerticalContentAlignment="Top">
      <HeaderedContentControl.Header>
        <localization:LocalizedExtension>
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.Tab.ObjectManager</Ctor>
        </localization:LocalizedExtension>
      </HeaderedContentControl.Header>
      <ScrollViewer>
        <Grid>
          <StackPanel>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Label Grid.Row="1" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.ObjectManager.FilterDoodads</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="1" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=ObjectPullUseBlacklist, Mode=TwoWay}">
                <FrameworkElement.ToolTip>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.ObjectManager.FilterDoodads.ToolTip</Ctor>
                  </localization:LocalizedExtension>
                </FrameworkElement.ToolTip>
              </CheckBox>
              <Label Grid.Row="2" Grid.Column="0" Margin="3">
                <ContentControl.Content>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.ObjectManager.LogPullData</Ctor>
                  </localization:LocalizedExtension>
                </ContentControl.Content>
              </Label>
              <CheckBox Grid.Row="2" Grid.Column="1" Margin="3,5,3,1" Content="" IsChecked="{Binding Path=ObjectPullLogData, Mode=TwoWay}">
                <FrameworkElement.ToolTip>
                  <localization:LocalizedExtension>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.ObjectManager.LogPullData.ToolTip</Ctor>
                  </localization:LocalizedExtension>
                </FrameworkElement.ToolTip>
              </CheckBox>
            </Grid>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</UserControl>