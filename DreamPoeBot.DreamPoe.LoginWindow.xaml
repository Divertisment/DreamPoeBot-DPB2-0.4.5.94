<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DreamPoeBot.DreamPoe.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localization="clr-namespace:DreamPoeBot.Localization.Wpf;assembly=DreamPoeBot.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:lex="http://wpflocalizeextension.codeplex.com" xmlns:controls1="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls" xmlns:settingsPath="clr-namespace:DreamPoeBot.Loki" xmlns:dreampoebot="clr-namespace:DreamPoeBot" xmlns:loc="clr-namespace:DreamPoeBot.Localization;assembly=DreamPoeBot.Localization" xmlns:dreampoe="clr-namespace:DreamPoeBot.DreamPoe">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <localization:LocalizedKeyConverter x:Key="RegionLabelConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <controls1:MetroProgressBar Name="metroProgressBar_0" HorizontalAlignment="Left, Stretch" VerticalAlignment="Top" IsIndeterminate="False" Height="25" Margin="10,164,10,0" Width="Auto">
      <!--Unknown connection ID: 2-->
    </controls1:MetroProgressBar>
    <Image HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,16,0,0" Width="16" Source="Images/key.png" Height="16" />
    <TextBox Name="KeyTextBox" HorizontalAlignment="Left, Stretch" VerticalAlignment="Top" Height="106" Width="Auto" FontSize="14" Margin="31,10,10,0" AcceptsReturn="True">
      <!--Unknown connection ID: 3-->
    </TextBox>
    <ComboBox Name="AuthRegionComboBox" DataContext="{x:Static settingsPath:GlobalSettings.Instance}" VerticalAlignment="Top" HorizontalAlignment="Left, Stretch" FontSize="14" Margin="31,135,107,0" SelectedValuePath="Value" ItemsSource="{Binding AuthRegionOptions}" SelectedValue="{Binding AuthRegion, Mode=TwoWay}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock>
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource RegionLabelConverter}" ConverterParameter="Authentication.Region.">
                <Binding Path="Value" />
                <Binding Path="Culture" Source="{x:Static loc:LocalizationManager.Current}" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
      <!--Unknown connection ID: 4-->
    </ComboBox>
    <Button Name="AuthLoginButton" HorizontalAlignment="Right" Margin="0,135,10,0" VerticalAlignment="Top" MinWidth="75" Width="Auto" HorizontalContentAlignment="Center">
      <ContentControl.Content>
        <localization:LocalizedExtension>
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Authentication.Login</Ctor>
        </localization:LocalizedExtension>
      </ContentControl.Content>
      <!--Unknown connection ID: 5-->
    </Button>
    <TextBlock Name="AuthLoginTextBlock" HorizontalAlignment="Left, Stretch" Margin="10,194,10,10" TextWrapping="Wrap" VerticalAlignment="Top, Stretch" Width="Auto" Height="Auto">
      <TextBlock.Text>
        <localization:LocalizedExtension>
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Authentication.Instructions</Ctor>
        </localization:LocalizedExtension>
      </TextBlock.Text>
      <!--Unknown connection ID: 6-->
    </TextBlock>
  </Grid>
  <!--Unknown connection ID: 1-->
</UserControl>